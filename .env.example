# Database (SQLite in locale)
DATABASE_URL="file:./dev.db?connection_limit=1"

# Segreto per le sessioni Auth.js: genera con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET=

# Credenziali dell'admin creato dal seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Quanti proxy fidati stanno davanti all'app (0 = nessuno: limiti di tentativi per IP spenti)
TRUSTED_PROXY_HOPS=0
